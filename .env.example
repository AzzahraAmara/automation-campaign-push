# Copy this file to .env and fill in values only in your local environment.
# Never commit .env or put real credentials in this template.

BQ_PROJECT=
BQ_LOCATION=
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
GOOGLE_SHEETS_CREDENTIALS=credentials/google-sheets-service-account.json

# Configure either the separate fields below or QUEUE_DB_URL, not both.
QUEUE_DB_SERVER=
QUEUE_DB_NAME=
QUEUE_DB_USER=
QUEUE_DB_PASSWORD=
QUEUE_DB_PORT=
QUEUE_DB_SCHEMA=
QUEUE_DB_URL=

# Optional email alerts. EMAIL_RECEIVER accepts comma-separated addresses.
EMAIL_SENDER=
EMAIL_PASSWORD=
EMAIL_RECEIVER=

# Gitea Actions only (store the full JSON contents as repository secrets):
# GOOGLE_APPLICATION_CREDENTIALS_JSON=
# GOOGLE_SHEETS_CREDENTIALS_JSON=
